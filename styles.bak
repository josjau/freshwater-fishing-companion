/* =========================================================
   FRESHWATER FISHING COMPANION
   CONCEPT 3 — OUTDOOR HERITAGE
   ========================================================= */

:root {
    color-scheme: dark;

    /* Backgrounds */
    --background: #263127;
    --surface: #344136;
    --surface-elevated: #404e41;
    --surface-hover: #4a594b;
    --surface-active: #556456;

    /* Text */
    --text: #f5ecd8;
    --text-muted: #d2c8b3;
    --text-subtle: #afa994;

    /* Primary accent */
    --accent: #b98245;
    --accent-hover: #cf9b5c;
    --accent-soft: rgba(185, 130, 69, 0.17);

    /* Section accents */
    --accent-fish: #879c65;
    --accent-rigs: #bd7543;
    --accent-recommendations: #c99b52;
    --accent-knots: #986747;
    --accent-tackle: #98905d;
    --accent-catch-log: #b98245;
    --accent-favorites: #c8a85b;
    --accent-regulations: #9e9985;
    --accent-settings: #7e5c45;

    /* Status */
    --success: #809a67;
    --warning: #cda052;
    --danger: #b86b58;
    --info: #84998a;

    /* Structure */
    --border: #6b755f;
    --border-strong: #838d76;

    /* Shape */
    --radius-small: 7px;
    --radius: 14px;
    --radius-large: 20px;

    /* Spacing */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;
    --space-12: 48px;

    /* Layout */
    --content-width: 960px;
    --touch-target: 48px;

    /* Effects */
    --shadow-card: 0 7px 20px rgba(14, 18, 13, 0.2);
    --shadow-card-hover: 0 11px 28px rgba(14, 18, 13, 0.29);
    --transition-fast: 140ms ease;
    --transition-standard: 220ms ease;
}

/* =========================================================
   RESET
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    min-height: 100%;
    background: var(--background);
    -webkit-text-size-adjust: 100%;
}

body {
    min-height: 100vh;
    margin: 0;
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.5;
}

button,
input,
select,
textarea {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

a {
    color: inherit;
}

img,
svg {
    display: block;
    max-width: 100%;
}

/* =========================================================
   TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
p {
    margin-top: 0;
}

h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(2rem, 8vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
}

h2 {
    margin-bottom: var(--space-5);
    font-size: clamp(1.3rem, 4vw, 1.65rem);
    line-height: 1.2;
}

p {
    margin-bottom: var(--space-4);
}

/* =========================================================
   APPLICATION LAYOUT
   ========================================================= */

.app-header,
.app-main,
.app-footer {
    width: min(calc(100% - 32px), var(--content-width));
    margin-inline: auto;
}

.app-header {
    padding-top: var(--space-10);
    padding-bottom: var(--space-6);
}

.app-header__content {
    max-width: 720px;
}

.app-header p {
    max-width: 620px;
    margin-bottom: 0;
    color: var(--text-muted);
    font-size: 1rem;
}

.app-main {
    padding-bottom: var(--space-12);
}

.app-footer {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--border);
}

.app-footer p {
    margin: 0;
    color: var(--text-subtle);
    font-size: 0.875rem;
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
}

.dashboard-card {
    position: relative;
    display: flex;
    min-height: 116px;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    margin: 0;
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-6);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
        linear-gradient(
            90deg,
            var(--accent-soft) 0,
            rgba(185, 130, 69, 0.08) 14px,
            transparent 26px
        ),
        var(--surface-elevated);
    box-shadow: var(--shadow-card);
    color: var(--text);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
        background var(--transition-standard),
        border-color var(--transition-standard),
        box-shadow var(--transition-standard),
        transform var(--transition-fast);
}

.dashboard-card::before {
    position: absolute;
    top: 16px;
    bottom: 16px;
    left: 0;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: var(--accent);
    content: "";
}

.dashboard-card--primary {
    min-height: 140px;
    padding-block: var(--space-6);
    border-color: var(--border-strong);
}

.dashboard-card--primary::before {
    width: 5px;
}

.dashboard-card:hover {
    border-color: var(--border-strong);
    background:
        linear-gradient(
            90deg,
            rgba(185, 130, 69, 0.18) 0,
            rgba(185, 130, 69, 0.08) 16px,
            transparent 30px
        ),
        var(--surface-hover);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
}

.dashboard-card:active {
    background: var(--surface-active);
    transform: scale(0.985);
}

.dashboard-card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
}

.dashboard-card__title {
    display: block;
    margin-bottom: var(--space-2);
    font-size: 1.125rem;
    font-weight: 750;
    line-height: 1.2;
}

.dashboard-card__description {
    display: block;
    max-width: 56ch;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.45;
}

.dashboard-card__action {
    display: block;
    margin-top: var(--space-5);
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
}

.dashboard-card:nth-child(1)::before {
    background: var(--accent-fish);
}

.dashboard-card:nth-child(2)::before {
    background: var(--accent-rigs);
}

.dashboard-card:nth-child(3)::before {
    background: var(--accent-recommendations);
}

.dashboard-card:nth-child(4)::before {
    background: var(--accent-tackle);
}

.dashboard-card:nth-child(5)::before {
    background: var(--accent-knots);
}

.dashboard-card:nth-child(6)::before {
    background: var(--accent-catch-log);
}

.dashboard-card:nth-child(7)::before {
    background: var(--accent-favorites);
}

.dashboard-card:nth-child(8)::before {
    background: var(--accent-regulations);
}

.dashboard-card:nth-child(9)::before {
    background: var(--accent-settings);
}

/* =========================================================
   GENERAL BUTTONS
   ========================================================= */

button {
    min-height: var(--touch-target);
}

button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

/* =========================================================
   RESPONSIVE LAYOUT
   ========================================================= */

@media (min-width: 640px) {
    .dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-card {
        min-height: 132px;
    }
}

@media (min-width: 900px) {
    .dashboard-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .app-header {
        padding-top: var(--space-12);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
