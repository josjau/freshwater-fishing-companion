/* =========================================================
   FRESHWATER FISHING COMPANION
   CONCEPT 1 — FOREST + COPPER
   ========================================================= */

:root {
    color-scheme: dark;

    /* Backgrounds */
    --background: #1b2a22;
    --surface: #26382d;
    --surface-elevated: #304438;
    --surface-hover: #385044;
    --surface-active: #415b4d;

    /* Text */
    --text: #f5f1e8;
    --text-muted: #c5c9bd;
    --text-subtle: #9da79d;

    /* Primary accent */
    --accent: #c7793f;
    --accent-hover: #dc9258;
    --accent-soft: rgba(199, 121, 63, 0.16);

    /* Section accents */
    --accent-fish: #86a96f;
    --accent-rigs: #c7793f;
    --accent-recommendations: #d19b48;
    --accent-knots: #a8754f;
    --accent-tackle: #9a9255;
    --accent-catch-log: #c39052;
    --accent-favorites: #d2ad5d;
    --accent-regulations: #9d9a87;
    --accent-settings: #8a684f;

    /* Status */
    --success: #77a66e;
    --warning: #d5a454;
    --danger: #c76a5d;
    --info: #88a596;

    /* Structure */
    --border: #506455;
    --border-strong: #687c6d;

    /* Shape */
    --radius-small: 8px;
    --radius: 16px;
    --radius-large: 22px;

    /* Spacing */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;
    --space-12: 48px;

    /* Layout */
    --content-width: 960px;
    --touch-target: 48px;

    /* Effects */
    --shadow-card: 0 8px 24px rgba(7, 15, 10, 0.18);
    --shadow-card-hover: 0 12px 30px rgba(7, 15, 10, 0.26);
    --transition-fast: 140ms ease;
    --transition-standard: 220ms ease;
}

/* =========================================================
   RESET
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    min-height: 100%;
    background: var(--background);
    -webkit-text-size-adjust: 100%;
}

body {
    min-height: 100vh;
    margin: 0;
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.5;
}

button,
input,
select,
textarea {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

a {
    color: inherit;
}

img,
svg {
    display: block;
    max-width: 100%;
}

/* =========================================================
   TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
p {
    margin-top: 0;
}

h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(2rem, 8vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
}

h2 {
    margin-bottom: var(--space-5);
    font-size: clamp(1.3rem, 4vw, 1.65rem);
    line-height: 1.2;
}

p {
    margin-bottom: var(--space-4);
}

/* =========================================================
   APPLICATION LAYOUT
   ========================================================= */

.app-header,
.app-main,
.app-footer {
    width: min(calc(100% - 32px), var(--content-width));
    margin-inline: auto;
}

.app-header {
    padding-top: var(--space-10);
    padding-bottom: var(--space-6);
}

.app-header__content {
    max-width: 720px;
}

.app-header p {
    max-width: 620px;
    margin-bottom: 0;
    color: var(--text-muted);
    font-size: 1rem;
}

.app-main {
    padding-bottom: var(--space-12);
}

.app-footer {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--border);
}

.app-footer p {
    margin: 0;
    color: var(--text-subtle);
    font-size: 0.875rem;
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
}

.dashboard-card {
    position: relative;
    display: flex;
    min-height: 116px;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    margin: 0;
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-6);
    overflow: hidden;
    border: 1px solid var(--border);
    border-left: 5px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-card);
    color: var(--text);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
        background var(--transition-standard),
        border-color var(--transition-standard),
        box-shadow var(--transition-standard),
        transform var(--transition-fast);
}

.dashboard-card:hover {
    border-color: var(--border-strong);
    border-left-color: var(--accent-hover);
    background: var(--surface-hover);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
}

.dashboard-card:active {
    background: var(--surface-active);
    transform: scale(0.985);
}

.dashboard-card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
}

.dashboard-card__title {
    display: block;
    margin-bottom: var(--space-2);
    font-size: 1.125rem;
    font-weight: 750;
    line-height: 1.2;
}

.dashboard-card__description {
    display: block;
    max-width: 56ch;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.45;
}

/* Temporary section accents based on card order */

.dashboard-card:nth-child(1) {
    border-left-color: var(--accent-fish);
}

.dashboard-card:nth-child(2) {
    border-left-color: var(--accent-rigs);
}

.dashboard-card:nth-child(3) {
    border-left-color: var(--accent-recommendations);
}

.dashboard-card:nth-child(4) {
    border-left-color: var(--accent-knots);
}

.dashboard-card:nth-child(5) {
    border-left-color: var(--accent-tackle);
}

.dashboard-card:nth-child(6) {
    border-left-color: var(--accent-catch-log);
}

.dashboard-card:nth-child(7) {
    border-left-color: var(--accent-favorites);
}

.dashboard-card:nth-child(8) {
    border-left-color: var(--accent-regulations);
}

.dashboard-card:nth-child(9) {
    border-left-color: var(--accent-settings);
}

/* =========================================================
   GENERAL BUTTONS
   ========================================================= */

button {
    min-height: var(--touch-target);
}

button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

/* =========================================================
   RESPONSIVE LAYOUT
   ========================================================= */

@media (min-width: 640px) {
    .dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-card {
        min-height: 132px;
    }
}

@media (min-width: 900px) {
    .dashboard-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .app-header {
        padding-top: var(--space-12);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
